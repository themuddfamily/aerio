# These values are embedded into the Electron main-process bundle at build time.
# Never use a Web OAuth client or commit a populated .env.local file.
MAIN_VITE_GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
MAIN_VITE_GOOGLE_CLIENT_SECRET=your-desktop-client-secret

# Aerio already has a committed public-client default. Set this only to override it.
# MAIN_VITE_MICROSOFT_CLIENT_ID=4369b922-aba6-4a2c-acef-2e1c51b8f372
